# ─────────────────────────────────────────────────────────────
# AWS Cloud Infrastructure Dashboard Configuration (.env)
# Copy this file to .env and customize your configuration values.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# 1. Dashboard Authentication Config
# ─────────────────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY

# ─────────────────────────────────────────────────────────────
# 2. AWS Credentials & Region Defaults
# (Leave empty if running on an EC2/Lightsail instance with IAM Role)
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=

# ─────────────────────────────────────────────────────────────
# 3. Database & Memory Caching Config
# ─────────────────────────────────────────────────────────────
DB_PATH=data/dashboard.db
CACHE_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────
# 4. Scanner Performance & Tuning Config
# ─────────────────────────────────────────────────────────────
SCANNER_MAX_THREADS=8
S3_SAFETY_MAX_OBJECTS=50000
EGRESS_COST_PER_GB=0.09

# ─────────────────────────────────────────────────────────────
# 5. Flask Web Server Config
# ─────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ─────────────────────────────────────────────────────────────
# 6. Gunicorn Production WSGI Config
# ─────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
